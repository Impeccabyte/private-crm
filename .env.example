# Copy to .env and fill in. Never commit .env.
# Values containing $ ! # must be single-quoted (Docker Compose interpolates $).

APP_URL=http://localhost:3000

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts EINs, bank numbers and integration secrets at rest. Changing it makes existing ciphertext unreadable.
APP_ENCRYPTION_KEY=

# Host-side tools (drizzle-kit, npm run dev). Docker Compose overrides this for its containers.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# First admin account, created by the seed if it does not exist (idempotent).
SEED_ADMIN_EMAIL='admin@example.com'
SEED_ADMIN_PASSWORD='change-me'
SEED_ADMIN_NAME='Admin User'

